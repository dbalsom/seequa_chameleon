	)
	(text_box "Like the IBM PC, the Chameleon enforces odd parity, storing the even parity result of the first 8 data bit in the 9th DRAM chip (bit D8)\n\nWhen writing, the parity bit input to the parity generator is forced to 0. The even parity result calculated from bits 0-7 is driven to data bit 8 to be stored.\n\nWhen reading, the parity bit D8 is included in the parity calculation, flipping the result of the calculation to odd parity. \n\nThus, an asserted EVEN_PARITY signal during a read operation MCy be considered a parity error.\n\n\n"
		(exclude_from_sim no)
		(at 116.84 297.18 0)
		(size 63.5 27.94)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type color)
			(color 255 229 191 1)
		)
		(effects
			(font
				(face "Arial")
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "5248523c-6161-4617-8a01-af0aee1b001f")
	)
