	)
	(text_box "/*  Pin 14: nVRAM_WR\n    CPU has been granted VRAM bus cycle (!nMUX_CPU) and is writing (!nMEMW)\nnVRAM_WR =\n    (!nMUX_CPU & !nMEMW);\n\n/*  Pin 15: nVRAM_RD\n    BXXX segment decoded and CPU is reading (!nMEMR)\n*/\nnVRAM_RD =\n    (A19 & !A18 & A17 & A16 & !nMEMR);\n\n/*  Pin 18: nVRAM_EN\n    BXXX segment decoded and CPU is reading (!nMEMR) or writing (!nMEMW) \n*/\nnVRAM_EN =\n    (A19 & !A18 & A17 & A16 & !nMEMW)\n  # (A19 & !A18 & A17 & A16 & !nMEMR);\n\n/*  Pin 16: nSRAM_EN\n    AF000-AFFFF decoded and CPU is reading (!nMEMR) or writing (!nMEMW) \n*/\nnSRAM_EN =\n    (A19 & !A18 & A17 & !A16 & A15 & A14 & A13 & A12 & !nMEMR)\n  # (A19 & !A18 & A17 & !A16 & A15 & A14 & A13 & A12 & !nMEMW);"
		(exclude_from_sim no)
