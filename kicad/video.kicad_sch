	(text_box "The officially documented CPU swap strobe is decoded here, with a required bodge wire running to CPX5."
		(exclude_from_sim no)
		(at 213.36 54.61 0)
		(size 24.13 15.24)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type color)
			(color 255 229 191 1)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "26cb354b-7120-4109-9931-5bf04329d927")
	)
	(text_box "This latch gates several signals to the next edge of the master clock. By feeding these inputs back into CRK and CRM, these PALs can perform edge-triggered logic.\n"
		(exclude_from_sim no)
		(at 685.8 294.64 0)
		(size 30.48 12.7)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type color)
			(color 219 255 214 1)
		)
		(effects
			(font
				(face "Arial")
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "b4022f51-c64e-44a7-a3d9-3fcead94bf99")
	)
	(text_box "This circuit performs writing pulse timing for the font SRAM, using the Chameleon's 16MHz floppy controller clock."
		(exclude_from_sim no)
		(at 254 193.04 0)
		(size 38.1 11.43)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type color)
			(color 255 255 194 1)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "b8cf1874-ed98-4fce-8e5a-e385e7449688")
	)
	(text_box "/*  Pin 14: nVRAM_WR\n    CPU has been granted VRAM bus cycle (!nMUX_CPU) and is writing (!nMEMW)\nnVRAM_WR =\n    (!nMUX_CPU & !nMEMW);\n\n/*  Pin 15: nVRAM_RD\n    BXXX segment decoded and CPU is reading (!nMEMR)\n*/\nnVRAM_RD =\n    (A19 & !A18 & A17 & A16 & !nMEMR);\n\n/*  Pin 18: nVRAM_EN\n    BXXX segment decoded and CPU is reading (!nMEMR) or writing (!nMEMW) \n*/\nnVRAM_EN =\n    (A19 & !A18 & A17 & A16 & !nMEMW)\n  # (A19 & !A18 & A17 & A16 & !nMEMR);\n\n/*  Pin 16: nSRAM_EN\n    AF000-AFFFF decoded and CPU is reading (!nMEMR) or writing (!nMEMW) \n*/\nnSRAM_EN =\n    (A19 & !A18 & A17 & !A16 & A15 & A14 & A13 & A12 & !nMEMR)\n  # (A19 & !A18 & A17 & !A16 & A15 & A14 & A13 & A12 & !nMEMW);"
		(exclude_from_sim no)
		(at 20.32 274.32 0)
		(size 66.04 41.91)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type color)
			(color 219 255 214 1)
		)
		(effects
			(font
				(face "Consolas")
				(size 1 1)
			)
			(justify left top)
		)
		(uuid "bffa4c1b-d28a-46ab-8a8b-5b2a952c936b")
	)
	(text_box "This pair of 4-bit counters creates the blink timings for the cursor and the blink text attribute. \nClocked by vsync, this toggles the cursor every 8 frames, and blinking text every 16 frames, the same as the IBM CGA.\n"
		(exclude_from_sim no)
		(at 194.31 280.67 0)
		(size 43.18 13.97)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type color)
			(color 255 229 191 1)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "dc1a2846-53da-4c11-be14-52a7a1f580ea")
	)
