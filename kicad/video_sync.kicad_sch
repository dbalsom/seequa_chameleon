	(text "Composite HSYNC Pulse"
		(exclude_from_sim no)
		(at 129.286 57.404 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "67784a3f-4327-48f6-8c24-0e93fcadf0eb")
	)
	(text_box "C87 & C88 drive the composite signal sync pulses.\nSeequa used Y5U caps, which are not ideal for this purpose, with high temperature sensitivity. If you are having issues with your Chameleon's composite output these are good candidate for replacement.\n\nIn theory 6.81 kΩ resistors would give a more accurate 4.7μs pulse but I am not sure if Seequa was factoring in other delays."
		(exclude_from_sim no)
		(at 39.37 57.15 0)
		(size 40.64 26.67)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type color)
			(color 219 255 214 1)
		)
		(effects
			(font
				(face "Arial")
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "2197c0ba-2eaf-454b-bd70-93e1a5659934")
	)
	(text_box "ln(2) ×3900×10^{−9} = 2.7μs"
		(exclude_from_sim no)
		(at 181.61 39.37 0)
