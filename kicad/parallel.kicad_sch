				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "65541f6e-95f9-446b-a23b-c59d637bc2e7")
	)
	(text_box "Bits 7-5 of the LPT Control Register are typically undefined.\nSeequa has added some useful bits here to read the NMI and interrupt status."
