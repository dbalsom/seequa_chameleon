	(text_box "The Status and Control regsiters are split across two buffers, according to which signals need to be inverted.\n\nU153 supplies bits 2 & 3 of the status register, with bits 4-7 supplied by U168.\n\nU168 inverts its outputs."
		(exclude_from_sim no)
		(at 238.76 64.77 0)
		(size 31.75 22.86)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
